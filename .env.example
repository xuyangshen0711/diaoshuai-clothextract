# OpenAI vision tagging (GPT-4o-mini)
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4o-mini
# Optional custom gateway:
# OPENAI_BASE_URL=https://api.openai.com/v1

# mock | openai
TAGGER_BACKEND=openai

# clip | local
# 首次启用 clip：python scripts/prepare_local_search.py --index
# 图片和文字在本机编码；运行期间只读取已缓存权重，不调用付费推理 API。
EMBEDDING_BACKEND=clip
CLIP_IMAGE_MODEL=clip-ViT-B-32
CLIP_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
