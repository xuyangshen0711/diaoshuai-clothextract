# OpenAI vision tagging (GPT-4o-mini)
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4o-mini
# Optional custom gateway:
# OPENAI_BASE_URL=https://api.openai.com/v1

# mock | openai | deepseek
TAGGER_BACKEND=openai

# DeepSeek vision tagging (deepseek-flash). Keys: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Thinking is on unless this is false / 0 / off. false sends thinking.type=disabled.
# https://api-docs.deepseek.com/zh-cn/guides/thinking_mode
DEEPSEEK_THINKING=true

# clip | local
# 首次启用 clip：python scripts/prepare_local_search.py --index
# 图片和文字在本机编码；运行期间只读取已缓存权重，不调用付费推理 API。
EMBEDDING_BACKEND=clip
CLIP_IMAGE_MODEL=clip-ViT-B-32
CLIP_TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1

# 数据库。下面整段留空时使用本机 SQLite（data/processed/catalog.sqlite3），不用安装 MySQL。
# 部署到阿里云 RDS 时填写 DATABASE_URL，或改填 MYSQL_*。不要把真实密码提交到仓库。
# DATABASE_URL=mysql://app_user:password@rm-xxxxxxxx.mysql.rds.aliyuncs.com:3306/diaoshuai?charset=utf8mb4
# MYSQL_HOST=rm-xxxxxxxx.mysql.rds.aliyuncs.com
# MYSQL_PORT=3306
# MYSQL_USER=app_user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=diaoshuai
# 走公网且 RDS 要求加密时设为 true。同一 VPC 内网一般不用。
# MYSQL_SSL=false

# 图片。下面整段留空时图片仍写在 data/ 目录。
# OSS_ENDPOINT 用地域节点，例如华东1（杭州）是 https://oss-cn-hangzhou.aliyuncs.com
# 和 ECS 同一地域时可以改成内网节点 https://oss-cn-hangzhou-internal.aliyuncs.com
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=diaoshuai-images
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 可选。配置后接口把图片地址指到 CDN；不配置则仍由 /api 读出图片。
# OSS_CDN_BASE_URL=https://img.example.com
# 可选的对象键前缀，一般留空。
# OSS_PREFIX=
# 设为 true 时上传 OSS 后仍保留 ECS 上的原文件。默认会在数据库提交成功后删掉本地副本。
# OSS_KEEP_LOCAL=false
